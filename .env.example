# --- Database (matches docker-compose.yml) ---
POSTGRES_USER=board
POSTGRES_PASSWORD=board
POSTGRES_DB=board
POSTGRES_PORT=5432
DATABASE_URL=postgresql://board:board@localhost:5432/board

# --- Auth --- generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Liveblocks ---
LIVEBLOCKS_SECRET_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
# Optional. Defaults to "Board <onboarding@resend.dev>" (Resend sandbox sender).
EMAIL_FROM=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Number of trusted reverse proxies in front of the app (used to find the real client IP
# for rate limiting). Vercel / a single proxy: 1.
TRUSTED_PROXY_COUNT=1

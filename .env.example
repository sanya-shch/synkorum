# --- Database (matches docker-compose.yml) ---
POSTGRES_USER=board
POSTGRES_PASSWORD=board
POSTGRES_DB=board
POSTGRES_PORT=5432
DATABASE_URL=postgresql://board:board@localhost:5432/board

# --- Auth --- generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Liveblocks ---
LIVEBLOCKS_SECRET_KEY=

# --- Email (Brevo transactional API) ---
BREVO_API_KEY=
# Required. "Name <address>" or a bare address. The address must be a verified sender in
# Brevo (Senders, Domains & Dedicated IPs).
EMAIL_FROM=

# --- "Try demo" (see docs/portfolio-mode.md) ---
# Cloudflare Turnstile. For local development use Cloudflare's always-pass test keys:
#   site key  1x00000000000000000000AA
#   secret    1x0000000000000000000000000000000AA
# Without the secret the check is skipped outside production and FAILS CLOSED in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: a view-only share link to a showcase board, offered when the demo is at capacity.
DEMO_FALLBACK_URL=
# Authenticates the weekly cleanup cron (Vercel sends it as a Bearer token). Any long random
# string, e.g. `openssl rand -base64 32`.
CRON_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Number of trusted reverse proxies in front of the app (used to find the real client IP
# for rate limiting). Vercel / a single proxy: 1.
TRUSTED_PROXY_COUNT=1
